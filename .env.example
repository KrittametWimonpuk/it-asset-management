# ---------------------------------------------------------------------------
# ตัวอย่างค่า Environment Variable
# วิธีใช้:  คัดลอกไฟล์นี้เป็น .env  แล้วแก้ค่าตามต้องการ
#   cp .env.example .env
# ---------------------------------------------------------------------------

# สาย connect ไปยัง PostgreSQL
# รูปแบบ: postgresql://<user>:<password>@<host>:<port>/<database>
# ค่านี้ตรงกับ docker-compose.yml (service ชื่อ db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appdb?schema=public"

# กุญแจลับสำหรับเซ็น JWT — ของจริงต้องสุ่มยาว ๆ และห้ามเปิดเผย
# สร้างได้ด้วย:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# พอร์ตที่ API จะรัน
PORT=4000

# ---------------------------------------------------------------------------
# RC2: Production Hardening — ตัวแปรใหม่ (ทุกตัวไม่บังคับ มี default ที่ใช้งานได้เลย)
# ---------------------------------------------------------------------------

# "development" (ค่าเริ่มต้นถ้าไม่ตั้ง) หรือ "production"
# ผลตอนนี้: กำหนดพฤติกรรม default ของ CORS เวลาไม่ได้ตั้งค่า CORS_ORIGIN ไว้ (ดูด้านล่าง)
NODE_ENV="development"

# origin ที่อนุญาตให้เรียก API ข้าม origin ได้ (คั่นด้วยจุลภาคถ้ามีหลายตัว) — ไม่ตั้งค่านี้ไว้:
#   - NODE_ENV=development: อนุญาตทุก origin (reflect origin ที่ขอมา) เหมือนพฤติกรรมเดิมตอน dev
#   - NODE_ENV=production:  ปิดรับ cross-origin request ทั้งหมด (fail closed เพื่อความปลอดภัย)
# ตัวอย่าง: CORS_ORIGIN="http://localhost:5173,https://asset.example.com"
CORS_ORIGIN=""

# อนุญาตเฉพาะ Cloudflare Pages preview ที่เป็น subdomain ของ production origin ใน CORS_ORIGIN
# เปิดใช้เฉพาะเมื่อ deploy frontend ผ่าน Cloudflare Pages
CORS_ALLOW_PAGES_PREVIEWS=false

# จำกัดจำนวนครั้งที่ยิง POST /api/auth/login และ /api/auth/register ได้ต่อ IP ในหน้าต่างเวลาเดียวกัน
# (กัน brute-force รหัสผ่าน/สแปมสร้างบัญชี) — ค่า default ถ้าไม่ตั้ง: 10 ครั้ง ต่อ 15 นาที
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
