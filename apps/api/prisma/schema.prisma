// ---------------------------------------------------------------------------
// Prisma schema — คำอธิบายโครงสร้างฐานข้อมูล
// เปลี่ยนไฟล์นี้แล้วรัน  npm run migrate:dev  เพื่อสร้าง/อัปเดตตารางจริง
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ตารางผู้ใช้ (สำหรับ Register / Login)
model User {
  id        String   @id @default(uuid())
  email     String   @unique // อีเมลห้ามซ้ำ
  password  String // เก็บเป็น "hash" เท่านั้น ไม่เก็บรหัสจริง
  name      String? // ? = ใส่หรือไม่ใส่ก็ได้
  role      UserRole @default(EMPLOYEE) // Milestone 4: สิทธิ์การใช้งาน — สมัครใหม่เป็น EMPLOYEE เสมอ (เปลี่ยนได้เฉพาะ ADMIN ในอนาคต)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[] // @deprecated ทางประวัติศาสตร์ (ผู้สร้าง asset) — ไม่ใช้บอก "ใครถือครองอยู่" อีกต่อไปตั้งแต่ Milestone 5 ดู Asset.ownerId

  // Milestone 5: ประวัติการมอบหมายครุภัณฑ์ — แยก 2 ความสัมพันธ์เพราะ Assignment ชี้มาที่ User สองทาง
  assignmentsHeld    Assignment[] @relation("AssignmentHolder") // รายการที่ตัวเองเป็นผู้ถือครอง (ทั้งอดีต+ปัจจุบัน)
  assignmentsCreated Assignment[] @relation("AssignmentAssignedBy") // รายการที่ตัวเองเป็นคนมอบหมายให้คนอื่น

  // Milestone 7: ใบแจ้งซ่อม/ปัญหา — แยก 2 ความสัมพันธ์เพราะ Ticket ชี้มาที่ User สองทางเช่นกัน
  ticketsReported Ticket[] @relation("TicketReportedBy") // ตั๋วที่ตัวเองเป็นผู้แจ้ง
  ticketsAssigned Ticket[] @relation("TicketAssignedTo") // ตั๋วที่ตัวเองถูกมอบหมายให้ดูแล (เฉพาะ ADMIN/IT_STAFF)
  approvedBorrowRequests BorrowRequest[] @relation("BorrowRequestApprovedBy")
}

// สิทธิ์การใช้งานของผู้ใช้ — Milestone 4 (RBAC)
enum UserRole {
  ADMIN // สิทธิ์เต็ม จัดการได้ทุกอย่างรวมถึงผู้ใช้
  IT_STAFF // จัดการ asset และ master data ได้ แต่จัดการผู้ใช้ไม่ได้
  EMPLOYEE // ดูได้เฉพาะ asset ของตัวเอง แก้ไข/ลบไม่ได้
}

// สถานะของ asset — ใช้ enum เพื่อจำกัดค่าที่เป็นไปได้ให้ชัดเจน
enum AssetStatus {
  AVAILABLE // พร้อมใช้งาน / อยู่ในคลัง
  IN_USE // กำลังถูกใช้งานอยู่
  REPAIR // อยู่ระหว่างซ่อม
  DISPOSED // เลิกใช้งาน / ตัดจำหน่ายแล้ว
}

// สภาพครุภัณฑ์ทางกายภาพ — เพิ่มใน Milestone 3 (Asset Details)
enum AssetCondition {
  NEW // ใหม่
  GOOD // สภาพดี
  FAIR // สภาพปานกลาง
  POOR // สภาพไม่ดี
  DAMAGED // ชำรุด
}

// ---------------------------------------------------------------------------
// Master Data — ข้อมูลอ้างอิงกลาง ใช้ร่วมกันทุก user ในระบบ (ไม่มี ownerId)
// ทุกตารางมีโครงคล้ายกัน: ชื่อห้ามซ้ำ (ไม่สนตัวพิมพ์เล็ก/ใหญ่ — บังคับจริงด้วย partial unique
// index ใน migration.sql), isActive ไว้ "ปิดใช้งานชั่วคราว" โดยไม่ต้องลบ, และ deletedAt ไว้ soft delete
// ---------------------------------------------------------------------------

// หมวดหมู่ครุภัณฑ์ เช่น Notebook, Desktop, Monitor, Printer
model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  assets      Asset[]

  @@index([deletedAt])
}

// สถานที่ตั้งครุภัณฑ์ เช่น Head Office, Warehouse, Server Room
model Location {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  assets      Asset[]

  @@index([deletedAt])
}

// แผนกที่ครอบครอง/ดูแลครุภัณฑ์ เช่น IT, HR, Finance
model Department {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  assets      Asset[]
  employees   Employee[]

  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// v1.1.0 Phase 1 — Employee Management Foundation
//
// Employee แยกจาก User โดยเจตนา: User เป็นบัญชีสำหรับ authentication/RBAC ส่วน Employee
// เป็น business identity ของผู้ถือครองครุภัณฑ์ โดย Assignment.user ยังเก็บไว้รองรับข้อมูลเดิม
// ---------------------------------------------------------------------------
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

model Employee {
  id           String         @id @default(uuid())
  employeeCode String         @unique
  firstName    String
  lastName     String
  fullName     String
  email        String?
  phone        String?
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     String?
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime?
  remark       String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  assignments  Assignment[]
  borrowRequests BorrowRequest[]

  @@index([departmentId])
  @@index([status])
  @@index([fullName])
  @@index([deletedAt])
}

// ผู้ขาย/ผู้ผลิตครุภัณฑ์ เช่น Dell, HP, Lenovo
model Vendor {
  id          String    @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  assets      Asset[]

  @@index([deletedAt])
}

// ตาราง Asset — ครุภัณฑ์/อุปกรณ์ IT ของผู้ใช้แต่ละคน
model Asset {
  id           String      @id @default(uuid())
  assetTag     String      @unique // เลขทะเบียนครุภัณฑ์ ห้ามซ้ำ
  name         String // ชื่ออุปกรณ์ เช่น "โน้ตบุ๊ค Dev Team"
  brand        String // ยี่ห้อ เช่น Dell, HP, Apple (ยังเป็น text — ไม่ใช่ master data)
  model        String // รุ่น เช่น "XPS 13" (ยังเป็น text — ไม่ใช่ master data)
  serialNumber String?     @unique // เลข serial จากผู้ผลิต (อาจไม่มี)
  status       AssetStatus @default(AVAILABLE) // สถานะปัจจุบัน

  // @deprecated ตั้งแต่ Milestone 5 — เดิมใช้บอกว่า asset นี้เป็นของใคร แต่ตอนนี้ "ผู้ถือครองปัจจุบัน"
  // ต้องดูจาก Assignment ล่าสุดที่ returnedAt IS NULL แทน (ดู utils/assignmentHelpers.js: getCurrentHolder)
  // เก็บคอลัมน์นี้ไว้แค่บันทึกว่า "ใครเป็นคนสร้าง asset นี้" ไม่ใช้ตัดสินสิทธิ์การมองเห็น/ความเป็นเจ้าของอีกต่อไป
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assignments Assignment[] // Milestone 5: ประวัติการมอบหมายทั้งหมด (ปัจจุบัน + อดีต) ของ asset นี้
  tickets     Ticket[] // Milestone 7: ใบแจ้งซ่อม/ปัญหาทั้งหมด (ปัจจุบัน + ประวัติ) ของ asset นี้
  borrowRequests BorrowRequest[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt // อัปเดตอัตโนมัติทุกครั้งที่แก้ไข
  deletedAt   DateTime? // soft delete: ไม่เป็น null แปลว่าถูก "ลบ" แล้ว (ยังอยู่ในฐานข้อมูลจริง)

  // ความสัมพันธ์กับ master data — categoryId บังคับ (แทนที่ text field เดิม)
  // location/department/vendor เป็นทางเลือก เพราะ asset ที่มีอยู่ก่อนหน้ายังไม่มีข้อมูลนี้
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // ---- Milestone 3: Asset Details & Technical Specifications — ทุกฟิลด์ด้านล่างไม่บังคับ (optional) ----

  // ข้อมูลทั่วไป
  description       String?
  assetCondition    AssetCondition?
  purchaseDate      DateTime?
  purchasePrice     Float?
  currency          String? // รหัสสกุลเงิน ISO 4217 เช่น THB, USD
  supplierReference String?
  invoiceNumber     String?
  warrantyExpiry    DateTime?
  remark            String?

  // ข้อมูลอุปกรณ์ (hardware/software)
  hostname        String?
  ipAddress       String? // IPv4
  macAddress      String?
  operatingSystem String?
  osVersion       String?
  cpu             String?
  ram             String?
  storage         String?
  graphics        String?
  monitorSize     String?

  // ข้อมูลเครือข่าย
  domainName String?
  lastSeenAt DateTime?

  // Lifecycle
  receivedDate  DateTime?
  installedDate DateTime?
  retiredDate   DateTime?

  // เก็บ index นี้ไว้เผื่อ query เก่า/ในอนาคตที่อ้างอิง ownerId (แม้จะไม่ใช้กรองสิทธิ์การมองเห็นแล้วก็ตาม)
  @@index([ownerId, deletedAt])
  @@index([categoryId])
  @@index([locationId])
  @@index([departmentId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Milestone 5 — Asset Assignment & Lifecycle
//
// Assignment คือประวัติการมอบหมายครุภัณฑ์ให้พนักงานถือครอง หนึ่งแถว = การมอบหมายหนึ่งรอบ
// (ตั้งแต่มอบจนกว่าจะคืน) ห้ามแก้ไข/ลบแถวเก่าเมื่อคืนแล้ว — ประวัติต้องอยู่ครบเสมอ
//
// "ผู้ถือครองปัจจุบัน" ของ asset หนึ่งชิ้น = Assignment ล่าสุดที่ returnedAt IS NULL AND
// deletedAt IS NULL (นี่คือ source of truth เดียว — ไม่ใช้ Asset.ownerId อีกต่อไป)
// asset หนึ่งชิ้นมี "แถวที่ active" แบบนี้ได้สูงสุด 1 แถวเท่านั้น บังคับจริงด้วย partial unique
// index บน assetId ใน migration.sql (เหมือนแพทเทิร์นชื่อ master data ที่ห้ามซ้ำ)
// ---------------------------------------------------------------------------
enum AssignmentStatus {
  ASSIGNED // กำลังถือครองอยู่ (active)
  RETURNED // คืนแล้วตามปกติ
  LOST // สูญหายระหว่างถือครอง
  DAMAGED // เสียหายระหว่างถือครอง
}

model Assignment {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // legacy holder relation — nullable ตั้งแต่ v1.1.0 Phase 2 และยังคงไว้เพื่ออ่านข้อมูลเก่า
  userId String?
  user   User?  @relation("AssignmentHolder", fields: [userId], references: [id], onDelete: Restrict)

  // business holder relation — รายการใหม่ทุกแถวต้องมีค่า (บังคับใน API ระหว่างช่วงเปลี่ยนผ่าน)
  // nullable ในฐานข้อมูลเพื่อรักษา assignment เก่าที่ไม่สามารถ backfill ได้อย่างแน่นอน
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  assignedById String // ผู้ทำรายการมอบหมาย (ADMIN/IT_STAFF) — ตั้งจาก req.user.id เสมอ ไม่รับจาก client
  assignedBy   User   @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  assignedAt         DateTime  @default(now())
  expectedReturnDate DateTime?
  returnedAt         DateTime? // ไม่เป็น null แปลว่าปิดรายการนี้แล้ว (คืน/หาย/เสียหาย) — ตั้งค่าได้ทางเดียวคือผ่าน endpoint /return

  status AssignmentStatus @default(ASSIGNED)

  conditionBefore AssetCondition? // สภาพตอนมอบหมาย (ใช้ enum เดียวกับ Asset.assetCondition)
  conditionAfter  AssetCondition? // สภาพตอนคืน — มีค่าก็ต่อเมื่อคืนแล้วเท่านั้น

  remark String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete (เผื่อไว้ใช้ในอนาคต — ยังไม่มี endpoint ลบใน milestone นี้)

  // query หลักของ list/get กรองด้วย assetId/userId/deletedAt เสมอ — index ช่วยให้ query เร็วขึ้น
  @@index([assetId, deletedAt])
  @@index([userId])
  @@index([employeeId])
  @@index([assignedById])
  @@index([status])
}

// ---------------------------------------------------------------------------
// v1.1.0 Phase 3 — Borrow Request Workflow
// คำขอยืมเป็นขั้นตอนก่อน Assignment; เมื่ออนุมัติ API จะสร้าง Assignment และปิดคำขอเป็น COMPLETED
// ---------------------------------------------------------------------------
enum BorrowRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model BorrowRequest {
  id            String              @id @default(uuid())
  requestNumber String              @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  requestedAt       DateTime @default(now())
  expectedReturnDate DateTime?
  reason             String
  status             BorrowRequestStatus @default(PENDING)

  approvedByUserId String?
  approvedByUser   User? @relation("BorrowRequestApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  rejectedReason   String?
  remark           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
  @@index([assetId])
  @@index([approvedByUserId])
  @@index([status, requestedAt])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Milestone 7 — Helpdesk & Maintenance
//
// Ticket คือใบแจ้งปัญหา/ซ่อมบำรุงของครุภัณฑ์หนึ่งชิ้น หนึ่งแถว = ปัญหาหนึ่งเรื่อง ห้ามลบประวัติ
// (เหมือนแพทเทิร์น Assignment — ดู deletedAt ด้านล่าง)
//
// วงจรชีวิต (บังคับจริงที่ backend ดู utils/ticketHelpers.js: TRANSITIONS):
//   OPEN -> IN_PROGRESS -> RESOLVED -> CLOSED
//   IN_PROGRESS <-> ON_HOLD (พักงานระหว่างทาง แล้วกลับมาทำต่อได้)
// RESOLVED ตั้งได้ทางเดียวคือผ่าน endpoint POST /:id/resolve (ต้องมาจาก IN_PROGRESS เท่านั้น)
// CLOSED ตั้งได้ทางเดียวคือผ่าน endpoint POST /:id/close (ต้องมาจาก RESOLVED เท่านั้น)
// PUT ทั่วไปแก้ได้แค่ OPEN/IN_PROGRESS/ON_HOLD เท่านั้น — ปิดโอกาสข้ามขั้นตอนผ่าน field ตรง ๆ
// ---------------------------------------------------------------------------
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN // เพิ่งแจ้งเข้ามา ยังไม่มีใครรับเรื่อง
  IN_PROGRESS // มีผู้ดูแลรับเรื่องแล้ว กำลังแก้ไข
  ON_HOLD // พักงานชั่วคราว (เช่น รอชิ้นส่วน/รออนุมัติ)
  RESOLVED // แก้ไขเสร็จแล้ว รอปิดงาน
  CLOSED // ปิดงานสมบูรณ์ (สถานะสุดท้าย แก้ไขต่อไม่ได้)
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  PRINTER
  ACCOUNT
  OTHER
}

model Ticket {
  id           String @id @default(uuid())
  ticketNumber String @unique // รูปแบบ HD-000001 — สร้างอัตโนมัติจาก DB sequence กันเลขซ้ำเสมอแม้ request พร้อมกัน (ดู utils/ticketHelpers.js)

  title       String
  description String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  reportedById String // ผู้แจ้งปัญหา — ตั้งจาก req.user.id เสมอ ไม่รับจาก client (กันแอบอ้างเป็นคนอื่น)
  reportedBy   User   @relation("TicketReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)

  assignedToId String? // ผู้ดูแล — เฉพาะ ADMIN/IT_STAFF เท่านั้น (บังคับที่ backend) ว่างได้ตอนยังไม่มีใครรับเรื่อง
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)
  category TicketCategory

  resolution String? // สรุปวิธีแก้ไข — บังคับกรอกตอนเรียก /resolve เท่านั้น

  openedAt   DateTime  @default(now())
  resolvedAt DateTime? // ไม่เป็น null แปลว่าผ่านขั้นตอน /resolve มาแล้ว
  closedAt   DateTime? // ไม่เป็น null แปลว่าผ่านขั้นตอน /close มาแล้ว (ปิดงานสมบูรณ์)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete (เผื่อไว้ใช้ในอนาคต — ยังไม่มี endpoint ลบใน milestone นี้ เหมือน Assignment.deletedAt)

  // query หลักของ list/get/dashboard กรองด้วยฟิลด์เหล่านี้เสมอ — index ช่วยให้ query เร็วขึ้น
  @@index([assetId, deletedAt])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Milestone 9 — Audit Log
//
// บันทึกการกระทำทางธุรกิจที่สำคัญทุกครั้ง (ไม่ใช่ทุก request) เป็นประวัติเท่านั้น — immutable
// (ไม่มี endpoint แก้ไข/ลบ) ดูรายการ action/entityType ที่รองรับที่ utils/auditLog.js
//
// ตั้งใจไม่ผูก relation แบบเป็นทางการกับ User (performedById เป็นแค่ string เก็บ id ดิบ ๆ) —
// เหตุผล 2 ข้อ: (1) ไม่ต้องแก้ model User เลยแม้แต่บรรทัดเดียวตามข้อกำหนด "ห้ามแก้ตารางเดิม เว้นแต่จำเป็นจริง ๆ"
// (2) ประวัติต้องอยู่ครบเสมอแม้ในอนาคตจะมี endpoint ลบผู้ใช้ — ถ้าผูก FK ปกติจะต้องตัดสินใจ onDelete
// (Cascade จะทำให้ประวัติหายไปด้วย, Restrict จะบล็อกการลบผู้ใช้ที่เคยทำรายการไว้) ซึ่งไม่มีคำตอบที่ถูกต้อง
// ชัดเจนในตอนนี้ — เก็บเป็น string เฉย ๆ ปลอดภัยที่สุด (routes/audit.js join กับ User เองตอนอ่านแทน)
model AuditLog {
  id String @id @default(uuid())

  action     String // CREATE/UPDATE/DELETE/ASSIGN/RETURN/OPEN/START_PROGRESS/ON_HOLD/RESOLVE/CLOSE/LOGIN/EXPORT_REPORT
  entityType String // Asset/Assignment/Ticket/Category/Location/Department/Vendor/User/Report
  entityId   String? // id ของ record ที่ถูกกระทำ — ไม่บังคับ (เช่น LOGIN ไม่มี entity ให้อ้างอิง)

  description String? // สรุปเหตุการณ์แบบอ่านง่าย (ภาษาไทย) เช่น "สร้างครุภัณฑ์ IT-0001 — Dell Latitude 5440"

  oldValues Json? // สถานะก่อนแก้ไข (เฉพาะ UPDATE/DELETE) — เก็บเฉพาะฟิลด์ที่เปลี่ยน ไม่ใช่ raw DB row ทั้งแถว
  newValues Json? // สถานะหลังแก้ไข (เฉพาะ CREATE/UPDATE) — ห้ามมี password hash/JWT ปนอยู่เด็ดขาด

  performedById String? // ผู้ทำรายการ — เก็บแค่ id ดิบ ๆ (ดูเหตุผลด้านบน)
  performedAt   DateTime @default(now())

  ipAddress String? // req.ip ตอนทำรายการ (ไม่บังคับ)
  userAgent String? // req.get('user-agent') ตอนทำรายการ (ไม่บังคับ)

  // query หลักของหน้า Audit Log กรอง/เรียงด้วยฟิลด์เหล่านี้เสมอ — index ช่วยให้ query เร็วขึ้น
  @@index([entityType, entityId])
  @@index([performedById])
  @@index([performedAt])
  @@index([action])
}
