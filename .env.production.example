# ---------------------------------------------------------------------------
# ตัวอย่างค่า Environment Variable — Production (RC3: Production Deployment & Operations)
#
# ใช้กับ docker-compose.prod.yml เท่านั้น (self-hosted บนเครื่อง/VPS ของตัวเอง) — ถ้า deploy ขึ้น
# AWS ECS ให้ใช้ deploy/config.sh แทน (ดู deploy/config.example.sh และ README: วิธี Deploy ขึ้น AWS ECS)
#
# วิธีใช้:
#   cp .env.production.example .env.production
#   แก้ค่าทุกตัวที่มีคำว่า CHANGE-ME ให้เป็นค่าจริง แล้วรัน:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# ห้าม commit .env.production ขึ้น git เด็ดขาด (.gitignore กันไว้แล้ว)
# ---------------------------------------------------------------------------

# ---- ฐานข้อมูล ----
# ใช้สร้าง Postgres container ใน docker-compose.prod.yml (service ชื่อ db)
DB_USER=postgres
DB_PASSWORD=CHANGE-ME-Strong-Passw0rd
DB_NAME=appdb

# connection string ที่ backend ใช้จริง — host เป็นชื่อ service "db" (อยู่ใน docker network เดียวกัน
# ไม่ใช่ localhost) ต้องตรงกับ DB_USER/DB_PASSWORD/DB_NAME ด้านบนเสมอ
DATABASE_URL="postgresql://postgres:CHANGE-ME-Strong-Passw0rd@db:5432/appdb?schema=public"

# ---- ความลับของแอป ----
# สร้างค่าสุ่มยาว ๆ ด้วย:  openssl rand -hex 32 — ห้ามใช้ค่าตัวอย่างนี้ในระบบจริงเด็ดขาด
JWT_SECRET=CHANGE-ME-to-a-long-random-secret

# ---- โหมดของแอป ----
# ต้องเป็น "production" เสมอสำหรับไฟล์นี้ — มีผลกับพฤติกรรม default ของ CORS (ดู CORS_ORIGIN ด้านล่าง)
NODE_ENV=production

# nginx เป็น reverse proxy หนึ่งชั้นหน้า Express; ใช้ค่า 1 เพื่อให้ req.ip/rate limit เห็น client จริง
TRUST_PROXY=1

# origin ของหน้าเว็บจริง (คั่นด้วยจุลภาคถ้ามีหลายตัว) — จำเป็นต้องตั้งเมื่อ NODE_ENV=production เพราะ
# ถ้าไม่ตั้งไว้ API จะปิดรับ cross-origin request ทั้งหมด (fail closed) ตามพฤติกรรม RC2
# หมายเหตุ: ถ้าเข้าเว็บผ่าน nginx (web service) ที่ port เดียวกับที่ proxy /api อยู่แล้ว (topology ปกติของ
# docker-compose.prod.yml นี้) ค่านี้ไม่มีผลจริง เพราะ browser มองว่าเป็น same-origin request อยู่แล้ว
# ตั้งไว้เผื่อกรณีมี client อื่นเรียก API ข้าม origin จริง ๆ เท่านั้น (เช่น mobile app)
CORS_ORIGIN=

# ---- Rate limiting (login/register) ----
# ไม่บังคับตั้ง — ค่า default ในโค้ดใช้งานได้เลย (10 ครั้ง/15 นาทีต่อ IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- พอร์ตที่ backend จะรันภายใน container ----
# ไม่ต้องเปลี่ยน เว้นแต่แก้ EXPOSE ใน apps/api/Dockerfile ด้วย
PORT=4000
# TLS certificate files used by docker-compose.prod.yml (absolute paths recommended)
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
