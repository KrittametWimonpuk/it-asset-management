# EditorConfig — ให้ editor ทุกตัวใช้กติกาการจัดรูปแบบเดียวกัน (indent, line ending, ฯลฯ)
# ดู https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,tsv}]
insert_final_newline = false
